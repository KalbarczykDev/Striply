@startuml Striply_Container_Diagram
!include <C4/C4_Container>

title Striply Container Diagram — Phase 0 v0.1 — 2026-08-05

LAYOUT_LEFT_RIGHT()

Person(merchant, "Merchant organization member", "Operates one organization through the dashboard.")
Person(customer, "Customer", "Completes a simulated hosted checkout.")
Person(operator, "Striply operator [planned]", "Uses restricted operational tooling.")

System_Ext(merchant_app, "Merchant application", "Calls organization-scoped APIs.")
System_Ext(webhook_receiver, "External webhook receiver", "Accepts signed, duplicate-tolerant event deliveries.")
System_Ext(email_service, "External email service [planned]", "Delivers invitations and transactional email.")

System_Boundary(striply, "Striply") {
    Container(web, "React Web Application [planned Phase 1]", "React, TypeScript", "Authenticated merchant dashboard and public hosted checkout in separate feature and route modules.")
    Container(api, "Spring Boot Application [bootstrap only]", "Java, Spring Boot", "Modular-monolith API, authorization, business use cases, simulator, transactions, and initial webhook delivery.")
    ContainerDb(db, "PostgreSQL [planned Phase 1]", "PostgreSQL", "Authoritative organization, catalog, checkout, payment, refund, webhook, audit, idempotency, and outbox data.")

    Container(worker, "Background Worker [planned Phase 3]", "Java, Spring Boot", "Outbox publication, durable jobs, webhook delivery, and retries using the backend codebase.")
    ContainerDb(redis, "Redis [planned Phase 3]", "Redis", "Non-authoritative rate-limit, coordination, or selected cache data after a measured need.")
    ContainerQueue(broker, "Message Broker [planned Phase 3+]", "Technology undecided", "Optional buffered asynchronous delivery after outbox and worker needs are measured.")
    Container(monitoring, "Monitoring Stack [planned Phase 4]", "Prometheus, Grafana", "Metrics collection, dashboards, and alerting.")
}

Rel(merchant, web, "Uses dashboard", "HTTPS")
Rel(customer, web, "Uses hosted checkout", "HTTPS; scoped session URL")
Rel(web, api, "Calls typed APIs", "HTTPS/JSON")
Rel(merchant_app, api, "Creates checkout sessions and uses permitted APIs", "HTTPS/JSON; API key")
Rel(api, db, "Reads and writes authoritative state", "JDBC; transactions")
Rel(api, webhook_receiver, "Delivers basic signed webhooks before worker extraction", "HTTPS/JSON; HMAC")

Rel(worker, db, "Claims pending work and stores outcomes [planned]", "JDBC; transactions")
Rel(worker, webhook_receiver, "Delivers and retries signed events [planned]", "HTTPS/JSON; HMAC")
Rel(worker, broker, "Publishes and consumes asynchronous work if justified [planned]", "Broker protocol")
Rel(api, redis, "Uses non-authoritative ephemeral data if justified [planned]", "Redis protocol over TLS")
Rel(monitoring, api, "Scrapes application metrics [planned]", "HTTP")
Rel(monitoring, worker, "Scrapes worker metrics [planned]", "HTTP")
Rel(worker, email_service, "Submits transactional email jobs [planned]", "HTTPS provider API")
Rel(operator, monitoring, "Views dashboards and alerts [planned]", "HTTPS; operator identity")

SHOW_LEGEND()

note right of broker
  Planned containers are architectural options or later-phase targets.
  Their presence does not mean they are implemented or currently required.
end note

@enduml
