erDiagram
    APP_USER {
        uuid id PK
        varchar public_id UK
        varchar normalized_email UK
        varchar password_hash
        varchar status
        timestamptz created_at
        timestamptz updated_at
    }

    ORGANIZATION {
        uuid id PK
        varchar public_id UK
        varchar name
        varchar status
        timestamptz created_at
        timestamptz updated_at
    }

    ORGANIZATION_MEMBER {
        uuid id PK
        uuid organization_id FK
        uuid user_id FK
        varchar role
        varchar status
        timestamptz created_at
        timestamptz updated_at
    }

    API_KEY {
        uuid id PK
        uuid organization_id FK
        uuid created_by_user_id FK
        varchar public_id UK
        varchar secret_hash
        varchar display_hint
        jsonb scopes
        varchar status
        timestamptz expires_at_nullable
        timestamptz created_at
        timestamptz revoked_at_nullable
    }

    CUSTOMER {
        uuid id PK
        uuid organization_id FK
        varchar public_id UK
        varchar email
        varchar name_nullable
        varchar status
        timestamptz created_at
        timestamptz updated_at
    }

    PRODUCT {
        uuid id PK
        uuid organization_id FK
        varchar public_id UK
        varchar name
        varchar description_nullable
        varchar status
        timestamptz created_at
        timestamptz updated_at
    }

    PRICE {
        uuid id PK
        uuid organization_id FK
        uuid product_id FK
        varchar public_id UK
        bigint amount_minor
        char currency
        varchar price_type
        varchar status
        timestamptz created_at
        timestamptz deactivated_at_nullable
    }

    CHECKOUT_SESSION {
        uuid id PK
        uuid organization_id FK
        uuid price_id FK
        uuid customer_id_nullable FK
        varchar public_id UK
        varchar product_name_snapshot
        bigint unit_amount_minor
        bigint total_amount_minor
        char currency
        int quantity
        varchar customer_email_snapshot_nullable
        varchar success_url
        varchar cancel_url
        varchar status
        timestamptz expires_at
        bigint version
        timestamptz created_at
        timestamptz updated_at
    }

    PAYMENT_INTENT {
        uuid id PK
        uuid organization_id FK
        uuid checkout_session_id FK
        varchar public_id UK
        bigint amount_minor
        char currency
        varchar status
        varchar simulator_scenario
        varchar outcome_code_nullable
        bigint version
        timestamptz created_at
        timestamptz updated_at
    }

    PAYMENT {
        uuid id PK
        uuid organization_id FK
        uuid checkout_session_id FK
        uuid payment_intent_id FK,UK
        varchar public_id UK
        bigint amount_minor
        bigint refunded_amount_minor
        bigint refund_reserved_amount_minor
        char currency
        bigint version
        timestamptz created_at
        timestamptz updated_at
    }

    REFUND {
        uuid id PK
        uuid organization_id FK
        uuid payment_id FK
        varchar public_id UK
        bigint amount_minor
        char currency
        varchar status
        varchar failure_code_nullable
        bigint version
        timestamptz created_at
        timestamptz updated_at
    }

    WEBHOOK_ENDPOINT {
        uuid id PK
        uuid organization_id FK
        varchar public_id UK
        varchar url
        bytea secret_ciphertext
        jsonb subscribed_event_types
        varchar status
        timestamptz created_at
        timestamptz updated_at
    }

    WEBHOOK_EVENT {
        uuid id PK
        uuid organization_id FK
        varchar public_id UK
        varchar event_type
        int schema_version
        jsonb payload
        timestamptz occurred_at
        timestamptz created_at
    }

    WEBHOOK_DELIVERY {
        uuid id PK
        uuid organization_id FK
        uuid webhook_event_id FK
        uuid webhook_endpoint_id FK
        varchar status
        int attempt_count
        timestamptz next_attempt_at_nullable
        timestamptz completed_at_nullable
        bigint version
        timestamptz created_at
        timestamptz updated_at
    }

    WEBHOOK_DELIVERY_ATTEMPT {
        uuid id PK
        uuid organization_id FK
        uuid webhook_delivery_id FK
        int attempt_number
        varchar outcome
        int http_status_nullable
        bigint duration_ms
        varchar error_code_nullable
        varchar response_excerpt_nullable
        timestamptz attempted_at
    }

    AUDIT_ENTRY {
        uuid id PK
        uuid organization_id FK
        varchar actor_type
        varchar actor_public_id
        varchar action
        varchar target_type
        varchar target_public_id_nullable
        varchar outcome
        jsonb metadata
        timestamptz created_at
    }

    IDEMPOTENCY_RECORD {
        uuid id PK
        uuid organization_id FK
        varchar operation
        varchar idempotency_key
        varchar request_fingerprint
        varchar status
        int response_status_nullable
        jsonb response_body_nullable
        varchar resource_type_nullable
        varchar resource_public_id_nullable
        timestamptz expires_at
        bigint version
        timestamptz created_at
        timestamptz updated_at
    }

    OUTBOX_EVENT {
        uuid id PK
        uuid organization_id FK
        varchar aggregate_type
        varchar aggregate_public_id
        varchar event_type
        int schema_version
        jsonb payload
        varchar status
        int attempt_count
        timestamptz available_at
        timestamptz claimed_at_nullable
        timestamptz published_at_nullable
        bigint version
        timestamptz created_at
    }

    APP_USER ||--o{ ORGANIZATION_MEMBER : "has memberships"
    ORGANIZATION ||--o{ ORGANIZATION_MEMBER : "contains"
    APP_USER ||--o{ API_KEY : "creates"
    ORGANIZATION ||--o{ API_KEY : "owns"

    ORGANIZATION ||--o{ CUSTOMER : "owns"
    ORGANIZATION ||--o{ PRODUCT : "owns"
    PRODUCT ||--o{ PRICE : "offers"
    ORGANIZATION ||--o{ PRICE : "owns"

    ORGANIZATION ||--o{ CHECKOUT_SESSION : "owns"
    PRICE ||--o{ CHECKOUT_SESSION : "snapshotted by"
    CUSTOMER |o--o{ CHECKOUT_SESSION : "optionally linked"
    CHECKOUT_SESSION ||--o{ PAYMENT_INTENT : "has sequential attempts"
    ORGANIZATION ||--o{ PAYMENT_INTENT : "owns"
    PAYMENT_INTENT ||--o| PAYMENT : "may produce"
    CHECKOUT_SESSION ||--o| PAYMENT : "produces at most one"
    ORGANIZATION ||--o{ PAYMENT : "owns"
    PAYMENT ||--o{ REFUND : "has"
    ORGANIZATION ||--o{ REFUND : "owns"

    ORGANIZATION ||--o{ WEBHOOK_ENDPOINT : "owns"
    ORGANIZATION ||--o{ WEBHOOK_EVENT : "owns"
    WEBHOOK_EVENT ||--o{ WEBHOOK_DELIVERY : "delivered through"
    WEBHOOK_ENDPOINT ||--o{ WEBHOOK_DELIVERY : "receives"
    ORGANIZATION ||--o{ WEBHOOK_DELIVERY : "owns"
    WEBHOOK_DELIVERY ||--o{ WEBHOOK_DELIVERY_ATTEMPT : "attempts"
    ORGANIZATION ||--o{ WEBHOOK_DELIVERY_ATTEMPT : "owns"

    ORGANIZATION ||--o{ AUDIT_ENTRY : "owns"
    ORGANIZATION ||--o{ IDEMPOTENCY_RECORD : "scopes"
    ORGANIZATION ||--o{ OUTBOX_EVENT : "owns"
