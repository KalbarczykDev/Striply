@startuml Striply_System_Context
!include <C4/C4_Context>

title Striply System Context — Phase 0 v0.1 — 2026-08-05

LAYOUT_LEFT_RIGHT()

Person(merchant, "Merchant organization member", "Operates one organization at a time through the dashboard.")
Person(customer, "Customer", "Completes a simulated hosted checkout without a merchant account.")
Person(operator, "Striply operator [planned]", "Observes and recovers the platform through restricted, audited access.")

Enterprise_Boundary(merchant_boundary, "Merchant-controlled environment — outside Striply trust boundary") {
    System_Ext(merchant_app, "Merchant application", "Creates checkout sessions and calls organization-scoped APIs.")
    System_Ext(webhook_receiver, "External webhook receiver", "Receives signed, at-least-once business events.")
}

Enterprise_Boundary(striply_boundary, "Striply trust boundary") {
    System(striply, "Striply", "Simulated payment infrastructure: dashboard, hosted checkout, API, simulator, payment and refund processing, webhooks, and audit behavior.")
}

System_Ext(email_service, "External email service [planned]", "Delivers invitations and transactional email after the first vertical slice.")
System_Ext(aws, "AWS hosting environment [planned Phase 5]", "Future deployment boundary, not a logical business integration.")

Rel(merchant, striply, "Operates organization and inspects activity", "HTTPS; user auth + organization authorization")
Rel(customer, striply, "Opens checkout and submits simulator scenario", "HTTPS; scoped session URL")
Rel(merchant_app, striply, "Creates checkout sessions and uses permitted APIs", "HTTPS/JSON; organization API key")
Rel(striply, webhook_receiver, "Delivers signed events; retries failures", "HTTPS/JSON; HMAC + timestamp")
Rel(operator, striply, "Observes, diagnoses, and recovers [planned]", "Restricted administrative access; audited")
Rel(striply, email_service, "Sends minimal transactional email data [planned]", "HTTPS provider API; service credential")
Rel(aws, striply, "Hosts in Phase 5 [planned]", "Infrastructure and runtime boundary")

SHOW_LEGEND()

note right of striply
  Solid relationships show direction of communication
  or the explicitly labeled future hosting relationship.
  Elements marked [planned] are not implemented.
end note

@enduml
